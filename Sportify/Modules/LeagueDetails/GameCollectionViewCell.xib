                            <!-- Center Stack: Score / VS / Date / Time -->
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" alignment="center" spacing="2" translatesAutoresizingMaskIntoConstraints="NO" id="YlT-1f-9YR">
                                <rect key="frame" x="82" y="8" width="100" height="88"/>

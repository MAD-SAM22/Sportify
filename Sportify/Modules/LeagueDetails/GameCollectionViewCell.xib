                            <!-- Away Team Image -->
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="YbM-cQ-KsE" userLabel="awayImageView">
                                <rect key="frame" x="200" y="12" width="52" height="52"/>
                                <color key="backgroundColor" red="0.15" green="0.18" blue="0.28" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="52" id="FbD-L1-Z73"/>
                                    <constraint firstAttribute="width" constant="52" id="h6s-Y0-DYT"/>
                                </constraints>
                                <userDefinedRuntimeAttributes>
                                    <userDefinedRuntimeAttribute type="number" keyPath="layer.cornerRadius">

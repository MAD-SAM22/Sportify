                                        <rect key="frame" x="0.0" y="38" width="100" height="16"/>
                                        <fontDescription key="fontDescription" type="boldSystem" pointSize="11"/>
                                        <color key="textColor" red="0.20" green="0.60" blue="1.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
